<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gripper_interface</name>
  <version>0.0.0</version>
  <description>
    Gripper interface node. Bridges the ROS controller pipeline to the gripper
    MCU via SocketCAN. Publishes GripperState from encoder CAN frames and
    forwards GripperStateVelocityCommand as PWM duty cycles over CAN.
  </description>
  <maintainer email="patricsh@stud.ntnu.no">patricsh</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>vortex_msgs</depend>
  <depend>vortex_utils_ros</depend>
  <depend>spdlog</depend>
  <depend>fmt</depend>

  <!-- SocketCAN is Linux kernel API — no ROS package dependency needed -->

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
